{
	"name": "theme-json-compiler",
	"version": "0.2.1",
	"description": "The Theme JSON Compiler recursively merges JSON and JavaScript files into a single theme.json file.",
	"source": "src/index.js",
	"main": "dist/index.js",
	"module": "dist/index.module.js",
	"types": "dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"import": "./dist/index.module.js",
		"require": "./dist/index.js",
		"default": "./dist/index.module.js"
	},
	"scripts": {
		"dev": "microbundle watch --target node --format cjs,es",
		"build": "rm -rf dist && microbundle --target node --format cjs,es"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dcooney/theme-json-compiler.git"
	},
	"files": [
		"dist"
	],
	"author": "Darren Cooney (darren.cooney@gmail.com)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/dcooney/theme-json-compiler/issues"
	},
	"keywords": [
		"generator",
		"theme.json",
		"theme json",
		"WordPress",
		"WordPress Theme JSON",
		"webpack",
		"webpack-plugin",
		"plugin"
	],
	"devDependencies": {
		"microbundle": "^0.15.1"
	}
}